<% content_for :navbar_text_label, "Edit Post" %>
<% content_for :navbar_text_path, post_path(@post) %>

<div class="container py-4">
  <div class="card shadow-sm rounded-5 p-4">
    <h2 class="h-default mb-4">Edit Post</h2>

    <%= form_with model: @post, class: "d-flex flex-column gap-3" do |f| %>
      <div>
        <%= f.label :title, "Title (optional)", class: "form-label" %>
        <%= f.text_field :title, class: "form-control", placeholder: "Give your post a title..." %>
      </div>

      <div>
        <%= f.label :content, "Content", class: "form-label" %>
        <%= f.text_area :content, rows: 6, class: "form-control", placeholder: "What's on your mind?", required: true %>
      </div>

      <div>
        <%= f.label :photo, "Image (optional)", class: "form-label" %>
        <% if @post.photo.attached? %>
          <div class="mb-2">
            <%= image_tag optimized_image_url(@post.photo, width: 200, height: 200), class: "rounded-3" %>
          </div>
        <% end %>
        <%= f.file_field :photo, class: "form-control", accept: "image/*" %>
      </div>

      <div class="d-flex gap-2 mt-3">
        <%= f.submit "Save changes", class: "btn button-default rounded-5" %>
        <%= link_to "Cancel", post_path(@post), class: "btn btn-outline-secondary rounded-5" %>
      </div>
    <% end %>
  </div>
</div>
