<div class="account-form-page">
  <div class="container">
    <div class="account-form-card text-center">
      <h1 class="account-form-title">Change your password</h1>
      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.error_notification %>

        <%= f.input :reset_password_token, as: :hidden %>
        <%= f.full_error :reset_password_token %>

        <%= f.input :password,
                    label: "New password",
                    placeholder: "New password",
                    required: true,
                    autofocus: true,
                    hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                    input_html: { class: "placeholder-custom", autocomplete: "new-password" } %>
        <%= f.input :password_confirmation,
                    label: "Confirm your new password",
                    placeholder: "Confirm your new password",
                    required: true,
                    input_html: { class: "placeholder-custom", autocomplete: "new-password" } %>

        <%= f.submit "Change my password", class: "btn button-default w-100 rounded-5 mb-2" %>
      <% end %>
      <div class="d-grid gap-3">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
