<div class="account-form-page">
  <div class="container">
    <div class="account-form-card text-center">
      <h1 class="account-form-title">Edit your profile</h1>
      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.error_notification %>

        <%= f.input :profile_name, placeholder: "Your profile name", input_html: { class: "placeholder-custom", autocomplete: "profile's name" } %>
        <%= f.input :email, placeholder: "Your email", input_html: { class: "placeholder-custom" } %>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
        <% end %>

        <%= f.input :password,
                    hint: "leave it blank if you don't want to change it",
                    required: false,
                    placeholder: "New password",
                    input_html: { class: "placeholder-custom", autocomplete: "new-password" } %>
        <%= f.input :password_confirmation,
                    required: false,
                    placeholder: "Confirm new password",
                    input_html: { class: "placeholder-custom", autocomplete: "new-password" } %>
        <%= f.input :current_password,
                    hint: "only required if you're changing your email or password",
                    required: false,
                    placeholder: "Current password",
                    input_html: { class: "placeholder-custom", autocomplete: "current-password" } %>
        <%= f.input :photo, as: :file %>
        <%= f.submit "Update", class: "btn button-default w-100 rounded-5 mb-2" %>
      <% end %>
      <div class="d-grid gap-3">
        <%= link_to "BACK", :back, class: "btn button-default w-100 rounded-5" %>
      </div>
    </div>

    <div class="account-danger-zone">
      <p class="account-danger-title">Unhappy?</p>
      <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "btn btn-danger rounded-5" %>
    </div>
  </div>
</div>
