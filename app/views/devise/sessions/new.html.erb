<div class="account-form-page">
  <div class="container">
    <div class="account-form-card text-center">
      <h1 class="account-form-title">Log in</h1>
      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    placeholder: "Your email",
                    input_html: { class: "placeholder-custom", autocomplete: "email" } %>

        <%= f.input :password,
                    required: false,
                    placeholder: "Your password",
                    input_html: { class: "placeholder-custom", autocomplete: "current-password" } %>

        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

        <%= f.submit "Log in", class: "btn button-default w-100 rounded-5 mb-2" %>
      <% end %>
      <div class="d-grid gap-3">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
