<% content_for :navbar_text_label, @user.profile_name || @user.email.split('@').first %>

<div class="user-hub-page">
  <div class="container py-4 py-md-5">

    <!-- Profile Header -->
    <div class="hub-profile-header">
      <div class="row align-items-center g-4">

        <!-- Avatar -->
        <div class="col-12 col-md-3 text-center">
          <div class="hub-avatar-wrapper">
            <% if @user.photo.attached? %>
              <%= image_tag @user.photo.variant(resize_to_limit: [280, 280]), alt: @user.profile_name, class: "hub-avatar" %>
            <% else %>
              <div class="hub-avatar-placeholder">
                <%= (@user.profile_name || @user.email.split('@').first).first.upcase %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Profile Info & Stats -->
        <div class="col-12 col-md-9">
          <div class="hub-profile-info">
            <div class="hub-profile-header-wrapper">
              <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-3">
                <div>
                  <h2 class="hub-username mb-1"><%= @user.profile_name || @user.email.split('@').first %></h2>
                  <p class="hub-member-since mb-0">Member since <%= @user.created_at.strftime("%B %Y") %></p>
                </div>
                <% if user_signed_in? && current_user == @user %>
                  <%= link_to edit_user_registration_path, class: "btn btn-hub-edit" do %>
                    <i class="fas fa-user-edit me-2"></i>Edit Profile
                  <% end %>
                <% end %>
              </div>
            </div>

            <!-- Stats -->
            <div class="hub-stats-grid">
              <div class="hub-stat-card">
                <div class="stat-icon"><i class="fas fa-newspaper"></i></div>
                <div class="stat-content">
                  <span class="stat-number"><%= @user.posts.count %></span>
                  <span class="stat-label">Posts</span>
                </div>
              </div>
              <div class="hub-stat-card">
                <div class="stat-icon"><i class="fas fa-utensils"></i></div>
                <div class="stat-content">
                  <span class="stat-number"><%= @user.recipes.count %></span>
                  <span class="stat-label">Recipes</span>
                </div>
              </div>
              <div class="hub-stat-card">
                <div class="stat-icon"><i class="fas fa-box"></i></div>
                <div class="stat-content">
                  <span class="stat-number"><%= @user.items.count %></span>
                  <span class="stat-label">Products</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Posts -->
    <div class="hub-tabs-wrapper mt-5">
      <h3 class="h-default mb-4">
        <i class="fas fa-newspaper me-2" style="color: #d34e4e;"></i>Posts
      </h3>

      <div class="feed-posts">
        <% if @posts.any? %>
          <% @posts.each do |post| %>
            <article class="feed-card rounded-4">

              <!-- Post Header -->
              <div class="feed-card-header">
                <div class="d-flex align-items-center">
                  <div class="feed-author-avatar">
                    <% if @user.photo.attached? %>
                      <%= image_tag @user.photo.variant(resize_to_limit: [150, 150]), alt: @user.profile_name, class: "avatar-img" %>
                    <% else %>
                      <div class="avatar-placeholder">
                        <%= (@user.profile_name || @user.email.split('@').first).first.upcase %>
                      </div>
                    <% end %>
                  </div>
                  <div class="flex-grow-1 ms-3">
                    <span class="feed-author-name">
                      <%= @user.profile_name || @user.email.split('@').first %>
                    </span>
                    <div class="feed-post-time">
                      <%= time_ago_in_words(post.created_at) %> ago
                    </div>
                  </div>
                  <% if user_signed_in? && current_user == @user %>
                    <div class="dropdown">
                      <button class="btn btn-link text-dark p-1" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-ellipsis-h"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end">
                        <li><%= link_to "Edit", edit_post_path(post), class: "dropdown-item" %></li>
                        <li><%= link_to "Delete", post_path(post), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "dropdown-item text-danger" %></li>
                      </ul>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Post Image -->
              <% if post.photo.attached? %>
                <div class="feed-card-image">
                  <%= image_tag post.photo.variant(resize_to_limit: [800, 800]), alt: post.title, class: "post-image" %>
                </div>
              <% end %>

              <!-- Post Content -->
              <%= link_to post_path(post), class: "feed-card-content-link" do %>
                <div class="feed-card-content">
                  <p class="mb-1">
                    <% if post.title.present? %>
                      <strong class="post-title-inline"><%= post.title %></strong>
                    <% end %>
                    <% if post.content.present? %>
                      <span class="post-content-text"><%= truncate(post.content, length: 200) %></span>
                    <% end %>
                  </p>
                </div>
              <% end %>

              <!-- Post Actions -->
              <div class="feed-card-actions">
                <div class="d-flex gap-3 align-items-center">
                  <div class="vote-buttons"
                       data-controller="vote"
                       data-vote-url-value="<%= post_vote_path(post) %>">
                    <button class="btn-vote upvote-btn"
                            data-action="vote#vote"
                            data-value="1">
                      <i class="fas fa-arrow-up"></i>
                    </button>
                    <span class="vote-count" data-vote-target="count">
                      <%= post.score %>
                    </span>
                    <button class="btn-vote downvote-btn"
                            data-action="vote#vote"
                            data-value="-1">
                      <i class="fas fa-arrow-down"></i>
                    </button>
                  </div>
                  <%= link_to post_path(post), class: "btn-action" do %>
                    <i class="far fa-comment"></i>
                  <% end %>
                </div>
              </div>

              <!-- Comments -->
              <div class="feed-card-comments">
                <% if post.comments.any? %>
                  <% if post.comments.size > 2 %>
                    <%= link_to "View all #{post.comments.size} comments", post_path(post), class: "view-all-comments" %>
                  <% end %>
                  <%= render 'shared/comments', comments: post.comments.sort_by { |c| [-c.score, -c.created_at.to_i] }.first(2), post: post %>
                <% end %>
                <%= render 'shared/comment_form', post: post %>
              </div>

            </article>
          <% end %>
        <% else %>
          <div class="feed-empty-state">
            <i class="fas fa-newspaper"></i>
            <h3>No posts yet</h3>
            <p><%= @user.profile_name || @user.email.split('@').first %> hasn't posted anything yet.</p>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>
