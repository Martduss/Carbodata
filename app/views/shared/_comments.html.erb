<% comments.each do |comment| %>
  <div class="comment-item" data-controller="toggle">
    <div class="d-flex align-items-start">
      <div class="flex-grow-1">
        <span class="comment-author">
          <%= comment.user.profile_name || comment.user.email.split('@').first %>
        </span>
        <span class="comment-text" data-toggle-target="content"><%= comment.content %></span>
        <span class="comment-time">
          <%= time_ago_in_words(comment.created_at) %> ago
        </span>
      </div>
      <% if current_user == comment.user %>
        <span class="comment-owner-icons">
          <button type="button" class="comment-icon-link" data-action="toggle#toggle">
            <i class="bi bi-pencil"></i>
          </button>
          <%= link_to post_comment_path(post, comment),
              data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this comment?" },
              class: "comment-icon-link comment-icon-delete" do %>
            <i class="bi bi-trash"></i>
          <% end %>
        </span>
      <% end %>
    </div>

    <%= form_with(model: [post, comment], local: true, class: "comment-form comment-edit-form d-none", data: { toggle_target: "content" }) do |f| %>
      <div class="comment-input-wrapper">
        <%= f.text_field :content,
            class: "comment-input",
            required: true,
            autocomplete: "off" %>
        <%= f.submit "Save", class: "btn-submit-comment" %>
      </div>
    <% end %>
  </div>
<% end %>
