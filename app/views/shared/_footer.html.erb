<% unless current_page?(home_path) || current_page?(root_path) || current_page?(new_user_session_path) || current_page?(new_user_registration_path) || current_page?(new_user_password_path) || current_page?(user_password_path) %>
  <nav class="footer navbar-light shadow-sm fixed-bottom border-top">
    <div class="container justify-content-center">
      <ul class="navbar-nav d-flex flex-row justify-content-center align-items-center gap-4 mb-0">

        <li class="foot-item">
          <%= link_to feed_path, "aria-label": "Feed" do %>
            <i class="bi bi-activity fs-1 btn rounded-5"></i>
          <% end %>
        </li>
        <li class="foot-item">
          <%= link_to chats_path, "aria-label": "Chats" do %>
            <i class="bi bi-robot fs-1 btn"></i>
          <% end %>
        </li>

        <li class="foot-item fab-container">
          <a class="fab-button"
             data-bs-toggle="offcanvas"
             href="#offcanvasAction"
             role="button"
             aria-controls="offcanvasAction"
             aria-label="<%= current_page?(profile_path) ? 'Search' : 'New CarboMeal' %>">
            <% if current_page?(profile_path) %>
              <i class="bi bi-search fs-1"></i>
            <% else %>
              <i class="bi bi-plus-lg fs-1"></i>
            <% end %>
          </a>
        </li>

        <li class="foot-item">
          <%= link_to recipes_path, "aria-label": "Carbomeals" do %>
            <i class="bi bi-book fs-1 btn"></i>
          <% end %>
        </li>
        <li class="foot-item">
          <%= link_to profile_path, "aria-label": "Profile" do %>
            <i class="bi bi-person fs-1 btn"></i>
          <% end %>
        </li>
      </ul>
    </div>
  </nav>
<% end %>
